    "title": "Studi Kasus Pembelian BSDE",
    "slug": "analisa-saham-bsde",
    "type": "analysis",
    "status": "published",
    "content_html": "\"\"",
    "content_json": [
      {
        "type": "text",
        "text": "<div class=\"flex justify-center mt-4\"><h2 class=\"font-bold w-full md:w-1/2 lg:w-1/2 mx-4 bg-[#020202]\">Studi Kasus Pembelian BSDE</h2>",
        "options": {
          "width": 100,
          "backgroundColorHex": "transparent",
          "textColorHex": "#ffdd28",
          "textSize": 30,
          "textAlign": "center"
        }
      },
      {
        "type": "text",
        "text": "<div class=\"flex justify-center\"><div class=\"w-full md:w-1/2 flex flex-col md:flex-row justify-center gap-2 mt-1 mb-1 border-t border-b-2 border-black p-1\">\n\n<p class=\"my-auto\"><i class=\"fa fa-user-circle my-auto\"></i> by Felix  Haridinata</p>\n\n<p class=\"my-auto\"><i class=\"ml-2 fa fa-calendar my-auto\"></i> April 29, 2021</p>\n\n<p class=\"my-auto\"><i class=\"ml-2 fa fa-tags my-auto\"></i> BSDE, Property & Real Estates</p>\n\n</div></div>",
        "options": {
          "width": 100,
          "backgroundColorHex": "transparent",
          "textColorHex": "#000000",
          "textSize": 20,
          "textAlign": "center"
        }
      },
      {
        "type": "spacer",
        "options": {
