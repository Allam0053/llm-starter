      {
        "type": "spacer",
        "options": {
          "height": 16,
          "width": 0,
          "widthPercentage": 100
        }
      },
      {
        "type": "text",
        "text": "<p></p>",
        "options": {
          "width": 100,
          "backgroundColorHex": "transparent",
          "textColorHex": "#000000",
          "textSize": 12,
          "textAlign": "center"
        }
      },
      {
        "type": "spacer",
        "options": {
          "height": 24,
