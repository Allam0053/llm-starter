    "content_json": [
      {
        "type": "header",
        "text": "<div class=\"flex justify-center mt-4\">\n    <h2 class=\"font-bold w-full md:w-1/2 lg:w-1/2 mx-4 bg-[#020202]\">\n        Quick Update Q3 WIFI\n    </h2>\n</div>",
        "options": {
          "width": 100,
          "backgroundColorHex": "transparent",
          "textColorHex": "#ffdd28",
          "textSize": 30,
          "textAlign": "center"
        }
